MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
DATABASE_NAME=hrms
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Generate a real secret with: openssl rand -hex 32
SECRET_KEY=<replace-with-a-long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh-token cookie (HttpOnly). Keep these for local http development.
# In production over https use COOKIE_SECURE=true, and COOKIE_SAMESITE=none
# when the frontend and the API are served from different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# SMTP, used for welcome and OTP emails. All five are required.
EMAIL_HOST=<smtp-host>
EMAIL_PORT=465
EMAIL_USER=<smtp-user>
EMAIL_PASSWORD=<smtp-password>
EMAIL_FROM=<sender-address>

# Directory for uploaded files, served at /uploads
UPLOAD_DIR=uploads

# First HR account. Created on startup only if this email does not already
# exist, so it is safe to leave set. Every other account is created by HR.
BOOTSTRAP_HR_EMAIL=<hr-admin-email>
BOOTSTRAP_HR_PASSWORD=<at-least-8-chars-with-upper-lower-digit-symbol>
BOOTSTRAP_HR_NAME=HR Admin

# Super admin account, created on startup the same way. It sits above HR and
# is the only account that can create, deactivate or unlock HR and manager
# accounts (Admin Accounts page). Leave empty to skip.
BOOTSTRAP_SUPER_ADMIN_EMAIL=<super-admin-email>
BOOTSTRAP_SUPER_ADMIN_PASSWORD=<at-least-8-chars-with-upper-lower-digit-symbol>
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin

# Cloudflare R2 private object storage. Keep these values backend-only.
R2_ACCOUNT_ID=<r2-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=<r2-bucket-name>
R2_SIGNED_URL_EXPIRY=900
