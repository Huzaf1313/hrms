MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
DATABASE_NAME=hrms
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Generate a real secret with: openssl rand -hex 32
SECRET_KEY=<replace-with-a-long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP, used for welcome and OTP emails. All five are required.
EMAIL_HOST=<smtp-host>
EMAIL_PORT=465
EMAIL_USER=<smtp-user>
EMAIL_PASSWORD=<smtp-password>
EMAIL_FROM=<sender-address>

# Directory for uploaded files, served at /uploads
UPLOAD_DIR=uploads